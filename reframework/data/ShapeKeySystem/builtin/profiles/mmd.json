{
  "schema": "sks.profile/1",
  "id": "mmd",
  "name": "MMD",
  "description": "PMX 模型的通用表情（保下限）：上眼皮、嘴角、张嘴、横拉、收窄、眉。每个通道按 any 列表找 mesh 上第一个存在的名字；全角/半角、大小写、空格不区分。选错的键可以另存一份 extends mmd 的配置，改 any 顺序后绑定到这个部件。",
  "aliases": [],
  "channels": [
    { "name": "ウィンク２", "group": "eye", "s": "blink.L",
      "any": ["ウインク２", "ウィンク２左", "ウィンク左２", "ウィンク", "ウインク", "ウィンク左", "wink2", "wink"],
      "note": "左眼闭眼（模型自己的左侧）。没有 ウィンク２ 时用 ウィンク（部分模型是笑眼形状，仍然会闭眼）" },
    { "name": "ｳｨﾝｸ２右", "group": "eye", "s": "blink.R",
      "any": ["ウインク２右", "ウィンク右２", "ウインク右２", "ウィンク２R", "ウィンク右", "ウインク右", "wink2_r", "wink_r"],
      "note": "右眼闭眼" },
    { "name": "まばたき", "group": "eye", "sum": [ { "s": "blink.L", "k": 0.5 }, { "s": "blink.R", "k": 0.5 } ],
      "any": ["瞬き", "blink", "眨眼", "闭眼", "目閉じ"],
      "unless": ["ウィンク２", "ｳｨﾝｸ２右"],
      "note": "双眼闭眼，只在没有左右 wink 键时使用" },
    { "name": "びっくり", "group": "eye", "sum": [ { "s": "eyeWide.L", "k": 0.5 }, { "s": "eyeWide.R", "k": 0.5 } ],
      "any": ["見開き", "驚き", "surprised"],
      "note": "睁大眼" },
    { "name": "じと目", "group": "eye",
      "mul": [ { "sum": [ { "s": "eyeSquint.L", "k": 0.5 }, { "s": "eyeSquint.R", "k": 0.5 } ] },
               { "sub": [ { "const": 1 }, { "sum": [ { "s": "blink.L", "k": 0.5 }, { "s": "blink.R", "k": 0.5 } ] } ] } ],
      "any": ["ジト目", "半目"],
      "note": "上眼皮半闭；闭眼时自动减弱，避免和闭眼叠加压穿" },
    { "name": "下瞼上げ", "group": "eye",
      "mul": [ { "sum": [ { "s": "cheekSquint.L", "k": 0.5 }, { "s": "cheekSquint.R", "k": 0.5 } ] },
               { "sub": [ { "const": 1 }, { "sum": [ { "s": "blink.L", "k": 0.5 }, { "s": "blink.R", "k": 0.5 } ] } ] } ],
      "any": ["下眼上", "下まつ毛上げ", "下まぶた上げ", "下眼睑上", "眼睑上", "眼睑上1"],
      "note": "下眼皮上抬（附加，多数模型没有）" },

    { "name": "あ", "group": "mouth", "s": "re9.vowel.A",
      "any": ["あ２", "あ2", "あ3", "あ4", "あ1", "ア", "あ"],
      "note": "元音 A（由原生发音驱动，不绑定物理下巴）" },
    { "name": "ワ", "group": "mouth", "s": "jawOpen",
      "any": ["ワ1", "ワ2", "大口", "ワ"],
      "note": "大张嘴（仅由物理下颌骨驱动）" },
    { "name": "い", "group": "mouth", "sum": [ { "s": "stretch.L", "k": 0.5 }, { "s": "stretch.R", "k": 0.5 } ],
      "any": ["い1", "い2", "い3", "イ", "い"],
      "note": "元音 I（横拉咧嘴露齿）" },
    { "name": "う", "group": "mouth", "sum": [ { "s": "funnel.L", "k": 0.5 }, { "s": "funnel.R", "k": 0.5 } ],
      "any": ["う1", "う2", "う3", "ウ", "う"],
      "note": "元音 U（嘟嘴/圆唇）" },
    { "name": "え", "group": "mouth", "sum": [ { "s": "upperLipUp.L", "k": 0.5 }, { "s": "upperLipUp.R", "k": 0.5 } ],
      "any": ["え1", "え2", "え3", "エ", "え"],
      "note": "元音 E（微开微提）" },
    { "name": "お", "group": "mouth", "sum": [ { "s": "funnelTogether.L", "k": 0.5 }, { "s": "funnelTogether.R", "k": 0.5 } ],
      "any": ["お1", "お2", "お3", "オ", "お"],
      "note": "元音 O（大漏斗收圆）" },
    { "name": "口角上げ", "group": "mouth", "max": [ { "s": "smile.L" }, { "s": "smile.R" } ],
      "any": ["口角上", "にこり口", "微笑", "にやり", "にこり"],
      "unless": ["口角上げ左", "口角上げ右"],
      "note": "嘴角上扬（对称键，没有左右版时使用）" },
    { "name": "口角上げ左", "group": "mouth", "s": "smile.L",
      "any": ["にこり左", "にこり1左", "にこり2左", "口角上左", "左口角上げ"] },
    { "name": "口角上げ右", "group": "mouth", "s": "smile.R",
      "any": ["にこり右", "にこり1右", "にこり2右", "口角上右", "右口角上げ"] },
    { "name": "口角下げ", "group": "mouth", "max": [ { "s": "frown.L" }, { "s": "frown.R" } ],
      "any": ["口角下げ1", "口角下げ2", "口角下", "への字", "∧"],
      "unless": ["口角下げ左", "口角下げ右"],
      "note": "嘴角下撇（对称键，没有左右版时使用）" },
    { "name": "口角下げ左", "group": "mouth", "s": "frown.L",
      "any": ["口角下左", "左口角下げ", "口角下げ1左"] },
    { "name": "口角下げ右", "group": "mouth", "s": "frown.R",
      "any": ["口角下右", "右口角下げ", "口角下げ1右"] },
    { "name": "口横広げ", "group": "mouth", "sum": [ { "s": "stretch.L", "k": 0.5 }, { "s": "stretch.R", "k": 0.5 } ],
      "any": ["口横広げ", "口横広げる", "口横伸ばし", "口横広"], "note": "嘴横拉" },
    { "name": "口横狭く", "group": "mouth", "sum": [ { "s": "funnelTogether.L", "k": 0.5 }, { "s": "funnelTogether.R", "k": 0.5 } ],
      "any": ["口横狭め", "口横缩げ", "口横縮め", "口すぼめ", "口横狭"], "note": "嘴收窄" },
    { "name": "口上", "group": "mouth", "sum": [ { "s": "upperLipUp.L", "k": 0.5 }, { "s": "upperLipUp.R", "k": 0.5 } ],
      "any": ["口上", "上唇上げ"], "note": "上唇上提（附加）" },
    { "name": "口下", "group": "mouth", "sum": [ { "s": "lowerLipDown.L", "k": 0.5 }, { "s": "lowerLipDown.R", "k": 0.5 } ],
      "any": ["口下", "下唇下げ"], "note": "下唇下拉（附加）" },

    { "name": "上", "group": "brow", "sum": [ { "s": "browOuterUp.L", "k": 0.5 }, { "s": "browOuterUp.R", "k": 0.5 } ],
      "any": ["眉上", "眉上げ"], "unless": ["上左", "上右"], "note": "眉上（对称键）" },
    { "name": "上左", "group": "brow", "s": "browOuterUp.L", "any": ["眉上左", "眉左上", "上左"] },
    { "name": "上右", "group": "brow", "s": "browOuterUp.R", "any": ["眉上右", "眉右上", "上右"] },

    { "name": "下", "group": "brow", "sum": [ { "s": "browDown.L", "k": 0.5 }, { "s": "browDown.R", "k": 0.5 } ],
      "any": ["眉下", "眉下げ", "真面目"], "unless": ["下左", "下右"], "note": "眉下（对称键）" },
    { "name": "下左", "group": "brow", "s": "browDown.L", "any": ["眉下左", "眉左下", "下左"] },
    { "name": "下右", "group": "brow", "s": "browDown.R", "any": ["眉下右", "眉右下", "下右"] },

    { "name": "困る", "group": "brow", "sum": [ { "s": "browInnerUp.L", "k": 0.5 }, { "s": "browInnerUp.R", "k": 0.5 } ],
      "any": ["困り", "眉困り"], "unless": ["困る左", "困る右"], "note": "眉心上提（对称键）" },
    { "name": "困る左", "group": "brow", "s": "browInnerUp.L", "any": ["困る1左", "困る2左", "困る左", "眉困り左"] },
    { "name": "困る右", "group": "brow", "s": "browInnerUp.R", "any": ["困る1右", "困る2右", "困る右", "眉困り右"] },

    { "name": "怒り", "group": "brow", "sum": [ { "s": "browBring.L", "k": 0.5 }, { "s": "browBring.R", "k": 0.5 } ],
      "any": ["眉怒り"], "unless": ["怒り左", "怒り右"], "note": "皱眉（对称键）" },
    { "name": "怒り左", "group": "brow", "s": "browBring.L", "any": ["怒り1左", "怒り左", "眉怒り左"] },
    { "name": "怒り右", "group": "brow", "s": "browBring.R", "any": ["怒り1右", "怒り右", "眉怒り右"] }
  ]
}
