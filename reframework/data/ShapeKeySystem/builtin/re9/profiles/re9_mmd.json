{
  "schema": "sks.profile/1",
  "id": "re9_mmd",
  "name": "RE9 MMD",
  "extends": null,
  "description": "RE9 原生面部输出整批映射；保留基础标定，按模型现有形态键匹配。",
  "aliases": [],
  "channels": [
    {
      "name": "上左",
      "group": "brow",
      "s": "browOuterUp.L",
      "any": [
        "眉上左",
        "眉左上"
      ]
    },
    {
      "name": "上右",
      "group": "brow",
      "s": "browOuterUp.R",
      "any": [
        "眉上右",
        "眉右上"
      ]
    },
    {
      "name": "下左",
      "group": "brow",
      "s": "browDown.L",
      "any": [
        "眉下左",
        "眉左下"
      ]
    },
    {
      "name": "下右",
      "group": "brow",
      "s": "browDown.R",
      "any": [
        "眉下右",
        "眉右下"
      ]
    },
    {
      "name": "口横広げ",
      "group": "mouth",
      "any": [
        "口横広げ",
        "口横広げる",
        "口横伸ばし"
      ],
      "note": "嘴唇纯横向展宽",
      "sum": [
        {
          "s": "stretch.L",
          "k": 0.5
        },
        {
          "s": "stretch.R",
          "k": 0.5
        }
      ],
      "unless": [
        "口横広げ左",
        "口横広げ右"
      ]
    },
    {
      "name": "びっくり",
      "group": "eye",
      "sum": [
        {
          "s": "eyeWide.L",
          "k": 0.5
        },
        {
          "s": "eyeWide.R",
          "k": 0.5
        }
      ],
      "any": [
        "見開き",
        "驚き",
        "surprised"
      ],
      "note": "睁大眼",
      "unless": [
        "びっくり左",
        "びっくり右"
      ]
    },
    {
      "name": "困る",
      "group": "brow",
      "sum": [
        {
          "s": "browInnerUp.L",
          "k": 0.5
        },
        {
          "s": "browInnerUp.R",
          "k": 0.5
        }
      ],
      "any": [
        "困り",
        "眉困り"
      ],
      "note": "眉心上提",
      "unless": [
        "困る左",
        "困る右"
      ]
    },
    {
      "name": "困る左",
      "group": "brow",
      "s": "browInnerUp.L"
    },
    {
      "name": "困る右",
      "group": "brow",
      "s": "browInnerUp.R"
    },
    {
      "name": "怒り左",
      "group": "brow",
      "s": "browBring.L"
    },
    {
      "name": "怒り右",
      "group": "brow",
      "s": "browBring.R"
    },
    {
      "name": "口横狭く",
      "group": "mouth",
      "any": [
        "口横缩げ",
        "口横狭く",
        "口横狭め"
      ],
      "note": "嘴唇纯横向收窄",
      "max": [
        {
          "sum": [
            {
              "s": "funnelTogether.L",
              "k": 0.5
            },
            {
              "s": "funnelTogether.R",
              "k": 0.5
            }
          ]
        },
        {
          "s": "upperLipRoll",
          "k": 0.5
        }
      ],
      "unless": [
        "口横狭め左",
        "口横狭め右"
      ]
    },
    {
      "name": "い",
      "group": "mouth",
      "any": [
        "い",
        "い1",
        "い2",
        "イ"
      ],
      "note": "I元音：嘴角纯横向平拉露齿（由CrnPl_09与Strtch_04横拉驱动，与张嘴完全解耦，不产生下巴污染）",
      "sum": [
        {
          "s": "stretch.L",
          "k": 0.5
        },
        {
          "s": "stretch.R",
          "k": 0.5
        }
      ]
    },
    {
      "name": "う",
      "group": "mouth",
      "any": [
        "う",
        "う1",
        "う2",
        "ウ"
      ],
      "note": "U元音：纯嘴唇向前圆拢收聚（由收嘴与卷唇内聚驱动，呈小圆嘟嘴）",
      "max": [
        {
          "sum": [
            {
              "s": "funnelTogether.L",
              "k": 0.5
            },
            {
              "s": "funnelTogether.R",
              "k": 0.5
            }
          ]
        },
        {
          "s": "upperLipRoll",
          "k": 0.6
        }
      ]
    },
    {
      "name": "え",
      "group": "mouth",
      "any": [
        "え1",
        "え2",
        "え3",
        "エ",
        "え"
      ],
      "note": "E元音：半开露齿横展（同时存在张嘴与横拉时精准触发，纯张嘴或纯闭嘴横拉均不触发）",
      "min": [
        {
          "s": "jawOpen",
          "k": 0.8
        },
        {
          "sum": [
            {
              "s": "stretch.L",
              "k": 0.6
            },
            {
              "s": "stretch.R",
              "k": 0.6
            }
          ]
        }
      ]
    },
    {
      "name": "お",
      "group": "mouth",
      "any": [
        "お1",
        "お2",
        "お3",
        "オ",
        "お"
      ],
      "note": "O元音：圆管漏斗开度（张嘴并伴随嘴唇收拢时触发，平拉张嘴时不误触）",
      "min": [
        {
          "s": "jawOpen",
          "k": 0.7
        },
        {
          "max": [
            {
              "s": "upperLipRoll",
              "k": 0.7
            },
            {
              "sum": [
                {
                  "s": "funnelTogether.L",
                  "k": 0.5
                },
                {
                  "s": "funnelTogether.R",
                  "k": 0.5
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "あ",
      "group": "mouth",
      "any": [
        "あ",
        "あ２",
        "あ2",
        "あ3",
        "あ4",
        "あ1",
        "ア"
      ],
      "note": "A元音：垂直自然张嘴（以下颌张开为主，减去横向拉伸与嘴唇收拢，避免微笑/圆唇发音时误触）",
      "sub": [
        {
          "s": "jawOpen",
          "k": 0.85
        },
        {
          "sum": [
            {
              "s": "stretch.L",
              "k": 0.35
            },
            {
              "s": "stretch.R",
              "k": 0.35
            },
            {
              "s": "upperLipRoll",
              "k": 0.5
            }
          ]
        }
      ]
    },
    {
      "name": "ウィンク２",
      "group": "eye",
      "s": "blink.L",
      "any": [
        "ウインク２",
        "ウィンク２左",
        "ウィンク左２",
        "ウィンク",
        "ウインク",
        "ウィンク左",
        "wink2",
        "wink"
      ],
      "note": "左眼闭眼（模型自己的左侧）。没有 ウィンク２ 时用 ウィンク（部分模型是笑眼形状，仍然会闭眼）"
    },
    {
      "name": "ｳｨﾝｸ２右",
      "group": "eye",
      "s": "blink.R",
      "any": [
        "ウインク２右",
        "ウィンク右２",
        "ウインク右２",
        "ウィンク２R",
        "ウィンク右",
        "ウインク右",
        "wink2_r",
        "wink_r"
      ],
      "note": "右眼闭眼"
    },
    {
      "name": "まばたき",
      "group": "eye",
      "sum": [
        {
          "s": "blink.L",
          "k": 0.5
        },
        {
          "s": "blink.R",
          "k": 0.5
        }
      ],
      "any": [
        "瞬き",
        "blink",
        "眨眼",
        "闭眼",
        "目閉じ"
      ],
      "unless": [
        "ウィンク２",
        "ｳｨﾝｸ２右"
      ],
      "note": "双眼闭眼，只在没有左右 wink 键时使用"
    },
    {
      "name": "じと目",
      "group": "eye",
      "mul": [
        {
          "sum": [
            {
              "s": "eyeSquint.L",
              "k": 0.5
            },
            {
              "s": "eyeSquint.R",
              "k": 0.5
            }
          ]
        },
        {
          "sub": [
            {
              "const": 1
            },
            {
              "sum": [
                {
                  "s": "blink.L",
                  "k": 0.5
                },
                {
                  "s": "blink.R",
                  "k": 0.5
                }
              ]
            }
          ]
        }
      ],
      "any": [
        "ジト目",
        "半目"
      ],
      "note": "上眼皮半闭；闭眼时自动减弱，避免和闭眼叠加压穿"
    },
    {
      "name": "下瞼上げ",
      "group": "eye",
      "mul": [
        {
          "sum": [
            {
              "s": "cheekSquint.L",
              "k": 0.5
            },
            {
              "s": "cheekSquint.R",
              "k": 0.5
            }
          ]
        },
        {
          "sub": [
            {
              "const": 1
            },
            {
              "sum": [
                {
                  "s": "blink.L",
                  "k": 0.5
                },
                {
                  "s": "blink.R",
                  "k": 0.5
                }
              ]
            }
          ]
        }
      ],
      "any": [
        "眼睑上",
        "眼睑上1",
        "下まつ毛上げ",
        "下まぶた上げ",
        "下眼上"
      ],
      "note": "下眼皮上抬（附加，多数模型没有）"
    },
    {
      "name": "ワ",
      "group": "mouth",
      "any": [
        "ワ",
        "ワ1",
        "ワ2",
        "大口"
      ],
      "note": "极限大张嘴/吼叫口型（死区门限0.60彻底隔绝日常说话，仅在极限张口/呐喊时触发）",
      "s": "jawOpen",
      "curve": {
        "deadzone": 0.6,
        "gain": 2.5
      }
    },
    {
      "name": "口角上げ",
      "group": "mouth",
      "max": [
        {
          "s": "smile.L"
        },
        {
          "s": "smile.R"
        }
      ],
      "any": [
        "口角上",
        "にこり口",
        "微笑",
        "にやり",
        "にこり"
      ],
      "unless": [
        "口角上げ左",
        "口角上げ右"
      ],
      "note": "嘴角上扬（对称键，没有左右版时使用）"
    },
    {
      "name": "口角上げ左",
      "group": "mouth",
      "s": "smile.L",
      "any": [
        "にこり左",
        "にこり1左",
        "にこり2左",
        "口角上左",
        "左口角上げ"
      ]
    },
    {
      "name": "口角上げ右",
      "group": "mouth",
      "s": "smile.R",
      "any": [
        "にこり右",
        "にこり1右",
        "にこり2右",
        "口角上右",
        "右口角上げ"
      ]
    },
    {
      "name": "口角下げ",
      "group": "mouth",
      "max": [
        {
          "s": "frown.L"
        },
        {
          "s": "frown.R"
        }
      ],
      "any": [
        "口角下げ",
        "口角下げ1",
        "口角下げ2"
      ],
      "unless": [
        "口角下げ左",
        "口角下げ右"
      ],
      "note": "嘴角下撇（对称键，没有左右版时使用）"
    },
    {
      "name": "口上",
      "group": "mouth",
      "any": [
        "口上",
        "上唇上げ"
      ],
      "note": "上唇抬起（微露上齿）",
      "max": [
        {
          "sum": [
            {
              "s": "upperLipUp.L",
              "k": 0.5
            },
            {
              "s": "upperLipUp.R",
              "k": 0.5
            }
          ]
        },
        {
          "s": "upperLipRoll",
          "k": 0.4
        }
      ]
    },
    {
      "name": "口下",
      "group": "mouth",
      "any": [
        "口下",
        "下唇下げ"
      ],
      "note": "下唇下压",
      "sub": [
        {
          "s": "jawOpen",
          "k": 0.45
        },
        {
          "sum": [
            {
              "s": "stretch.L",
              "k": 0.25
            },
            {
              "s": "stretch.R",
              "k": 0.25
            }
          ]
        }
      ]
    }
  ]
}